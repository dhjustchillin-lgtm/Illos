+static u8 MenuPal_ProcessInput(u8 selection)
+{
+    if (JOY_NEW(DPAD_RIGHT))
+    {
+        if (selection < MENU_PAL_COUNT - 1)
+        {
+            selection++;
+            sArrowPressed = TRUE;
+        }
+        else
+        {
+            selection = 0;
+            sArrowPressed = TRUE;
+        }
+    }
+    if (JOY_NEW(DPAD_LEFT))
+    {
+        if (selection != 0)
+        {
+            selection--;
+            sArrowPressed = TRUE;
+        }
+        else
+        {
+            selection = MENU_PAL_COUNT - 1;
+            sArrowPressed = TRUE;
+        }
+    }
+
+    return selection;
+}
+
+static void MenuPal_DrawChoices(u8 selection)
+{
+    u8 text[16] = {EOS};
+    u8 n = selection + 1;
+    u16 i;
+
+    for (i = 0; gText_MenuPalNumber[i] != EOS && i <= 5; i++)
+        text[i] = gText_MenuPalNumber[i];
+
+    // Convert a number to decimal string
+    if (n / 10 != 0)
+    {
+        text[i] = n / 10 + CHAR_0;
+        i++;
+        text[i] = n % 10 + CHAR_0;
+        i++;
+    }
+    else
+    {
+        text[i] = n % 10 + CHAR_0;
+        i++;
+        text[i] = CHAR_SPACER;
+        i++;
+    }
+
+    text[i] = EOS;
+
+    DrawOptionMenuChoice(gText_MenuPalColor, 104, YPOS_MENUPAL, 0);
+    DrawOptionMenuChoice(text, 134, YPOS_MENUPAL, 1);
+}
