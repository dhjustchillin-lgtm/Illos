+    HeatStartMenu_ExitAndClearTilemap();
+    FreezeObjectEvents();
+    LoadUserWindowBorderGfx(sSaveInfoWindowId, STD_WINDOW_BASE_TILE_NUM, BG_PLTT_ID(STD_WINDOW_PALETTE_NUM));
